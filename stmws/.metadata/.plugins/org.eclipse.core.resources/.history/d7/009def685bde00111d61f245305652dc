// main.c

#include "stm32f4xx_hal.h"
#include "main.h"
#include<string.h>


#define TRUE 1
#define FALSE 0

void SystemClockConfig(void);
void UART2_Init(void);
void Error_Handler(void);
void HAL_UART_TxCpltCallback(UART_HandleTypeDef *huart);
uint8_t convert2Capital(uint8_t data);


UART_HandleTypeDef huart2;

char *user_data = "Hello Buddy\r";

uint8_t data_buf[100];
uint8_t buf_data;
uint32_t count = 0;

int main(void) {
	HAL_Init();
	SystemClockConfig();
	UART2_Init();
	if (HAL_UART_Transmit(&huart2, (uint8_t*)user_data, (uint16_t)strlen(user_data), HAL_MAX_DELAY) != HAL_OK) {
		Error_Handler();
	}

	HAL_UART_Receive_IT(&huart2, &buf_data, 1);

	while(1){};
}

void SystemClockConfig(void) {

}

void UART2_Init(void) {
	huart2.Instance = USART2;
	huart2.Init.BaudRate = 115200;
	huart2.Init.WordLength = UART_WORDLENGTH_8B;
	huart2.Init.StopBits = UART_STOPBITS_1;
	huart2.Init.Parity = UART_PARITY_NONE;
	huart2.Init.HwFlowCtl = UART_HWCONTROL_NONE;
	huart2.Init.Mode = UART_MODE_TX_RX;
	if (HAL_UART_Init(&huart2) != HAL_OK) {
		Error_Handler();
	}
}

void Error_Handler(void) {
	while(1){};
}

uint8_t convert2Capital(uint8_t data)
{
	if ((data >= 'a') && (data <= 'z'))
	{
		data = data -('a' - 'A');
	}
	return data;
}

void HAL_UART_TxCpltCallback(UART_HandleTypeDef *huart)
{
	if (buf_data == '\r')
	{
		return
	}
	else
	{
		data_buf[count++] = buf_data;

	}
}
